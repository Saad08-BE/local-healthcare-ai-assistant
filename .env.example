# Local services only. Public or cloud endpoints are rejected at startup.
HEALTHCARE_OLLAMA_BASE_URL=http://127.0.0.1:11434
HEALTHCARE_LLM_MODEL=qwen2.5:3b
HEALTHCARE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

HEALTHCARE_CHUNK_SIZE=600
HEALTHCARE_CHUNK_OVERLAP=100
HEALTHCARE_TOP_K=5
HEALTHCARE_SIMILARITY_THRESHOLD=0.35

HEALTHCARE_HOST=127.0.0.1
HEALTHCARE_PORT=8501
HEALTHCARE_DEBUG=false

